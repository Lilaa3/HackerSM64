<?xml version="1.0" ?>
<behavior name="0x13004e78" readable_name="Rotating Octagonal Platform">
    <comment>The angular velocity and collision model are selected via behavior parameters.</comment>
    <description>An octagonal platform that rotates at a constant angular velocity.</description>
    <tags>
        <tag>PLATAFORM</tag>
        <tag>ENVIRONMENTAL</tag>
        <tag>SURFACE</tag>
    </tags>
    <fields>
        <field name="Rotation Speed" type="int" shift="8" mask="0xFF" default="0">
            <enums>
                <enum value="0" name="300" c_name="300"/>
                <enum value="1" name="-300" c_name="-300"/>
                <enum value="2" name="600" c_name="600"/>
                <enum value="3" name="-600" c_name="-600"/>
            </enums>
        </field>
        <field name="Collision Model" type="int" byte="2" default="0">
            <enums>
                <enum value="0" name="Model 0" c_name="bits_seg7_collision_0701AA84"/>
                <enum value="1" name="Model 1" c_name="rr_seg7_collision_07029508"/>
            </enums>
        </field>
    </fields>
    <models>
        <model>bits_octagonal_platform</model>
        <model>rr_octagonal_platform</model>
    </models>
</behavior>
