    <tags>
        <tag>NPC</tag>
        <tag>HOLDABLE</tag>
    </tags>
    <fields>
        <field name="Ukiki Type" type="int" shift="0" mask="0xFF" default="0">
            <enums>
                <enum value="0" name="Cage" c_name="None"/>
                <enum value="1" name="Cap" c_name="UKIKI_BP_CAP"/>
            </enums>
        </field>
    </fields>
    <models>
        <model>ukiki</model>
    </models>
</behavior>
