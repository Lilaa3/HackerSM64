<?xml version="1.0" ?>
<behavior name="0x13001f90" readable_name="Tox Box">
    <description>A moving platform that cycles through movement actions based on one of three direction tables selected by the behavior parameter. Includes a screen-shake effect when Mario is within 3000 units.</description>
    <tags>
        <tag>ENVIRONMENTAL</tag>
        <tag>MOVING</tag>
        <tag>PLATFORM</tag>
    </tags>
    <fields>
        <field name="Movement Pattern" type="int" shift="8" mask="0x03" default="0">
            <enums>
                <enum value="0" name="Pattern 1" c_name="sToxBoxDirectionPattern1"/>
                <enum value="1" name="Pattern 2" c_name="sToxBoxDirectionPattern2"/>
                <enum value="2" name="Pattern 3" c_name="sToxBoxDirectionPattern3"/>
            </enums>
        </field>
    </fields>
    <models>
        <model>ssl_tox_box</model>
    </models>
</behavior>
