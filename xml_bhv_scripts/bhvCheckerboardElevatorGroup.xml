<?xml version="1.0" ?>
<behavior name="0x13001b70" readable_name="Checkerboard Elevator Group">
    <description>Spawner that creates a pair of bhvCheckerboardPlatformSub objects. Position and scale are determined by the platform type.</description>
    <tags>
        <tag>SPAWNER</tag>
        <tag>PLATFORM</tag>
    </tags>
    <fields>
        <field name="Platform Type" type="int" shift="24" mask="0xFF" default="0">
            <enums>
                <enum value="0" name="BOB"/>
                <enum value="1" name="VCUTM"/>
            </enums>
        </field>
        <field name="Vertical Offset" type="units" byte="2" default="65" multiplier="10"/>
    </fields>
    <models>
        <model>checkerboard_platform</model>
    </models>
</behavior>
