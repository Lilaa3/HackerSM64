<?xml version="1.0" ?>
<behavior name="0x13004ccc" readable_name="TTC Cog">
    <description>A rotating cog in TTC, available as a hexagon or triangle. Its rotation direction is configurable.</description>
    <tags>
        <tag>ENVIRONMENTAL</tag>
        <tag>TTC</tag>
    </tags>
    <fields>
        <field name="Rotation Direction" type="int" shift="8" mask="0x01" default="0">
            <enums>
                <enum value="0" name="Clockwise" c_name="TTC_COG_BP_DIR_CLOCKWISE"/>
                <enum value="1" name="Counter-Clockwise" c_name="TTC_COG_BP_DIR_COUNTER_CLOCKWISE"/>
            </enums>
        </field>
        <field name="Shape" type="int" shift="9" mask="0x01" default="0">
            <enums>
                <enum value="0" name="Hexagon" c_name="TTC_COG_BP_SHAPE_HEXAGON"/>
                <enum value="1" name="Triangle" c_name="TTC_COG_BP_SHAPE_TRIANGLE"/>
            </enums>
        </field>
    </fields>
    <models>
        <model>ttc_rotating_hexagon</model>
        <model>ttc_rotating_triangle</model>
    </models>
</behavior>
