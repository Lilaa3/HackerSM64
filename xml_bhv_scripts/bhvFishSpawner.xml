<?xml version="1.0" ?>
<behavior name="0x1300215c" readable_name="Fish Spawner">
    <description>A general-purpose fish spawner that manages the creation of fish schools.</description>
    <tags>
        <tag>SPAWNER</tag>
        <tag>FISH</tag>
        <tag>WATER</tag>
    </tags>
    <fields>
        <field name="Spawner Type" type="int" shift="8" mask="0xFF" default="0">
            <description>The type of fish to spawn and the quantity.</description>
            <enums>
                <enum value="0" name="Many Blue" c_name="FISH_SPAWNER_BP_MANY_BLUE"/>
                <enum value="1" name="Few Blue" c_name="FISH_SPAWNER_BP_FEW_BLUE"/>
                <enum value="2" name="Many Cyan" c_name="FISH_SPAWNER_BP_MANY_CYAN"/>
                <enum value="3" name="Few Cyan" c_name="FISH_SPAWNER_BP_FEW_CYAN"/>
            </enums>
        </field>
        <field name="Flags" type="bitflag" byte="2" shift="4" default="0">
            <enums>
                <enum value="16" name="In Full Water Level" c_name="FISH_BP_FLAG_IN_FULL_WATER_LEVEL"/>
            </enums>
        </field>
    </fields>
</behavior>
