<?xml version="1.0" ?>
<behavior name="0x13004580" readable_name="Koopa">
    <description>A versatile Koopa Troopa with several variations: normal, unshelled, tiny, and Koopa the Quick. Each variation affects movement speed, agility, and behavior.</description>
    <tags>
        <tag>ENEMY</tag>
        <tag>Common</tag>
    </tags>
    <fields>
        <field name="Movement Type" type="int" byte="2" default="0">
            <enums>
                <enum value="0" name="Normal" c_name="KOOPA_BP_NORMAL"/>
                <enum value="1" name="Unshelled" c_name="KOOPA_BP_UNSHELLED"/>
                <enum value="2" name="Tiny" c_name="KOOPA_BP_TINY"/>
                <enum value="3" name="Koopa the Quick (BoB)" c_name="KOOPA_BP_KOOPA_THE_QUICK_BOB"/>
                <enum value="4" name="Koopa the Quick (THI)" c_name="KOOPA_BP_KOOPA_THE_QUICK_THI"/>
            </enums>
        </field>
    </fields>
    <models>
        <model>koopa_with_shell</model>
        <model>koopa_without_shell</model>
    </models>
</behavior>
