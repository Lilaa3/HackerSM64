<?xml version="1.0" ?>
<behavior name="bhvFloomba" readable_name="Floomba">
    <description>A blue variant of the Goomba. It sets oIsFloomba to TRUE and inherits all movement, AI, and parameter logic from bhvGoomba.</description>
    <tags>
        <tag>ENEMY</tag>
        <tag>Common</tag>
        <tag>Individual</tag>
    </tags>
    <fields>
        <field name="Animation Speed" type="int" shift="24" mask="0xFF" default="0">
            <description>Multiplied by 1/16 to determine animation speed.</description>
        </field>
        <field name="Size" type="int" shift="16" mask="0x03" default="0">
            <enums>
                <enum value="0" name="Regular" c_name="GOOMBA_SIZE_REGULAR"/>
                <enum value="1" name="Huge" c_name="GOOMBA_SIZE_HUGE"/>
                <enum value="2" name="Tiny" c_name="GOOMBA_SIZE_TINY"/>
            </enums>
        </field>
        <field name="Triplet Flag" type="int" shift="16" mask="0xFC" default="0">
            <description>Used when spawned by a Goomba Triplet Spawner.</description>
        </field>
        <field name="Zoom Limit" type="int" shift="8" mask="0x7F" default="0">
            <description>Limit for the zoom counter.</description>
        </field>
        <field name="Mirrored Startup Anim" type="bool" shift="8" mask="0x80" default="False"/>
        <field name="Internal Flag" type="bool" shift="0" mask="0xFF" default="False">
            <description>If set, decreases oBehParams once.</description>
        </field>
    </fields>
    <models>
        <model>goomba</model>
    </models>
</behavior>
